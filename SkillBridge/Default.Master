<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Default.master.cs" Inherits="SkillBridge.Default" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                <!-- CSS Stylesheets -->
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
                <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
                <link href="../css/style.css" rel="stylesheet">
                <link href="../css/tables.css" rel="stylesheet">
                <link href="../css/forms.css" rel="stylesheet">
                <link href="../css/responsive.css" rel="stylesheet">
                <!-- Loader wrapper -->
                <div id="loader-wrapper">
                    <div class="loader"></div>
                </div>

                <!-- Header Partition -->
                <header>
                    <!-- Shared Header Navbar -->
                    <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
                        <div class="container">
                            <a class="navbar-brand navbar-brand-custom" href="index.html">
                                <i class="fa-solid fa-graduation-cap text-accent"></i>
                                <span>Skill</span>Bridge
                            </a>
                            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                                <i class="fa-solid fa-bars"></i>
                            </button>
                            <div class="collapse navbar-collapse" id="mainNavbar">
                                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                                    <li class="nav-item">
                                        <a class="nav-link nav-link-custom active" href="index.html">Home</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link nav-link-custom" href="about.html">About Us</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link nav-link-custom" href="internship-list.html">Find Internships</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link nav-link-custom" href="contact.html">Contact</a>
                                    </li>
                                </ul>
                                <div class="header-actions">
                                    <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle theme">
                                        <i class="fa-solid fa-moon"></i>
                                    </button>
                                    <a href="login.html" class="btn btn-outline-primary btn-nav">Log In</a>
                                    <a href="register.html" class="btn btn-primary btn-nav shadow-sm">Register</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </header>
            </asp:ContentPlaceHolder>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
            </asp:ContentPlaceHolder>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder3" runat="server">
                <!-- Footer -->
                <footer class="footer-custom">
                    <div class="container">
                        <div class="row g-4 mb-5">
                            <div class="col-lg-4 col-md-6">
                                <a class="navbar-brand navbar-brand-custom text-white mb-3" href="index.html">
                                    <i class="fa-solid fa-graduation-cap text-accent"></i>
                                    <span>Skill</span>Bridge
                                </a>
                                <p class="footer-text mb-4">A focused internship portal for students, employers, and administrators to manage opportunities, applications, and hiring progress in one place.</p>
                                <div class="d-flex flex-wrap gap-2">
                                    <a href="#" class="footer-social-btn" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                                    <a href="#" class="footer-social-btn" aria-label="Twitter"><i class="fa-brands fa-twitter"></i></a>
                                    <a href="#" class="footer-social-btn" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                                    <a href="#" class="footer-social-btn" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-6">
                                <h5>For Students</h5>
                                <a href="internship-list.html" class="footer-link">Find Internships</a>
                                <a href="student-dashboard.html" class="footer-link">Dashboard</a>
                                <a href="recommendation.html" class="footer-link">Recommendations</a>
                                <a href="my-applications.html" class="footer-link">Track Applications</a>
                            </div>
                            <div class="col-lg-2 col-md-6">
                                <h5>For Employers</h5>
                                <a href="register.html?type=company" class="footer-link">Post an Internship</a>
                                <a href="company-dashboard.html" class="footer-link">Company Dashboard</a>
                                <a href="applicants.html" class="footer-link">Browse Applicants</a>
                                <a href="login.html" class="footer-link">Employer Login</a>
                            </div>
                            <div class="col-lg-4 col-md-6">
                                <h5>Quick Access</h5>
                                <a href="about.html" class="footer-support-link">
                                    <span>About SkillBridge</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>
                                <a href="contact.html" class="footer-support-link">
                                    <span>Contact Support</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>
                                <a href="login.html" class="footer-support-link">
                                    <span>Sign In</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>
                                <a href="register.html" class="footer-support-link mb-0">
                                    <span>Create Account</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                        <div class="footer-divider"></div>
                        <div class="footer-bottom">
                            <p class="mb-0">&copy; 2026 SkillBridge Internship Portal. All rights reserved.</p>
                            <div class="footer-legal-links">
                                <a href="#" class="text-muted footer-link mb-0">Privacy Policy</a>
                                <a href="#" class="text-muted footer-link mb-0">Terms of Service</a>
                            </div>
                        </div>
                    </div>
                </footer>

                <!-- Scripts -->
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
                <script src="../js/script.js"></script>
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
